    "name": "テスト用ブログから本番用ブログにデザインコピーする方法を教えてください",
    "title": "テスト用ブログから本番用ブログにデザインコピーする方法を教えてください",
    "source_locale": "ja",
    "locale": "ja",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-11-26T06:38:12Z",
    "user_segment_id": null,
