    "name": "【はてなブログ】【iOSアプリ】記事の復元機能について",
    "title": "【はてなブログ】【iOSアプリ】記事の復元機能について",
    "source_locale": "ja",
    "locale": "ja",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-10-14T08:03:25Z",
