    "name": "【はてなブログ】【iOSアプリ】公開済みの記事を下書きに戻す",
    "title": "【はてなブログ】【iOSアプリ】公開済みの記事を下書きに戻す",
    "source_locale": "ja",
    "locale": "ja",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-10-26T05:51:45Z",
