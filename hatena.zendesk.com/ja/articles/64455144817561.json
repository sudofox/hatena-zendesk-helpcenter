    "name": "【はてなブログ】【Androidアプリ】通知の許可を変更する",
    "title": "【はてなブログ】【Androidアプリ】通知の許可を変更する",
    "source_locale": "ja",
    "locale": "ja",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-11-26T01:46:55Z",
