    "name": "【はてなブログ】【iOSアプリ】お知らせを確認する",
    "title": "【はてなブログ】【iOSアプリ】お知らせを確認する",
    "source_locale": "ja",
    "locale": "ja",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-10-26T06:31:09Z",
