    "name": "【はてなブログ】【iOSアプリ】プッシュ通知が届かないときは",
    "title": "【はてなブログ】【iOSアプリ】プッシュ通知が届かないときは",
    "source_locale": "ja",
    "locale": "ja",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-11-06T07:23:52Z",
    "user_segment_id": null,
