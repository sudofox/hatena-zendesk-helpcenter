    "name": "【はてなブログ】【iOSアプリ】ブログの公開範囲を変更する",
    "title": "【はてなブログ】【iOSアプリ】ブログの公開範囲を変更する",
    "source_locale": "ja",
    "locale": "ja",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-10-26T05:50:22Z",
    "user_segment_id": null,
