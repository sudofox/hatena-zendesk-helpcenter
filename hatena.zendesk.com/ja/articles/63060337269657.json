    "name": "【はてなブログ】【iOSアプリ】記事・下書きを削除する",
    "title": "【はてなブログ】【iOSアプリ】記事・下書きを削除する",
    "source_locale": "ja",
    "locale": "ja",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-10-13T06:27:35Z",
    "user_segment_id": null,
    "permission_group_id": 972331,
