    "name": "【はてなブログ】【iOSアプリ】ブログ設定を開く・変更できる項目",
    "title": "【はてなブログ】【iOSアプリ】ブログ設定を開く・変更できる項目",
    "source_locale": "ja",
    "locale": "ja",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-10-23T09:49:47Z",
    "user_segment_id": null,
