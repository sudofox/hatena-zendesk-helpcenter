    "name": "【はてなブログ】【iOSアプリ】公開済みの記事を修正する",
    "title": "【はてなブログ】【iOSアプリ】公開済みの記事を修正する",
    "source_locale": "ja",
    "locale": "ja",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-10-14T08:01:01Z",
